# Shell scripts and Python must use LF — they run on Linux
*.sh  text eol=lf
*.py  text eol=lf
*.md  text eol=lf
# PDB is a fixed-column format with significant trailing spaces: normalize line
# endings, but don't let the whitespace gate flag (or "fix") deposited structures.
*.pdb text eol=lf -whitespace

# Binary data — never apply line-ending conversion
*.npy binary
*.png binary
*.pdf binary
